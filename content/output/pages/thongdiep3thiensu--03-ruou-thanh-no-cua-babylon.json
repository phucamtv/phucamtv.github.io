      "callout": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "\"Một vị thiên sứ khác, là vị thứ hai, theo sau mà rằng: Ba-by-lôn lớn kia, đã đổ rồi, đã đổ rồi, vì nó có cho các dân tộc uống rượu tà dâm thạnh nộ của nó.\" (Khải Huyền 14:8)",
              "link": null
            },
            "annotations": {
