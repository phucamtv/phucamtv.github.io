      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Có phải Chủ nhật là ngày của Chúa hay không?\nNgày Sa-bát là ngày nào?\nNgày Sa-bát được dựng nên cho ai?\nNgày thứ bảy bắt đầu và chấm dứt lúc nào?\nTại sao Sa-tan muốn đổi ngày Sa-bát?",
              "link": null
            },
            "annotations": {
