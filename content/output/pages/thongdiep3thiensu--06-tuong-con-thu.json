      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Thánh Kinh cung cấp cho thông tin về con thú cho chúng ta nhiều đến mức… không thể không nhận ra! Ở buổi thảo luận hôm nay, hãy cùng anh em chúng tôi tìm kiếm tung tích về tượng con thú.",
              "link": null
            },
            "annotations": {
