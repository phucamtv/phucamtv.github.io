      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Nói đến Khải Huyền, không thể không nói đến con thú, tượng con thú. Vì các thế lực này được Thiên Chúa miêu tả rất chi tiết ở chương 12, 13, 14, 17, 18, 19, 20.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
            "plain_text": "Nói đến Khải Huyền, không thể không nói đến con thú, tượng con thú. Vì các thế lực này được Thiên Chúa miêu tả rất chi tiết ở chương 12, 13, 14, 17, 18, 19, 20.",
