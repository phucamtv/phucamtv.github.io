      "type": "paragraph",
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "\"Sự thờ phượng thật\" là nền tảng vững chắc để chúng ta hiểu được thông điệp của vị thiên sứ thứ 3. Vì thế, trong buổi Thảo Luận Thánh Kinh hôm nay, anh em chúng tôi đi sâu vào chìa khoá quan trọng này, hầu qua đó, chúng ta, những người tìm hiểu Thánh Kinh có thể nhận dạng được những sự lừa dối kinh khủng trong những ngày cuối cùng này.",
              "link": null
            },
            "annotations": {
              "bold": false,
              "italic": false,
              "strikethrough": false,
              "underline": false,
              "code": false,
              "color": "default"
            },
